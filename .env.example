NINECGPA_ENVIRONMENT=development
# JSON list of exact frontend origins. Empty disables cross-origin browser access.
NINECGPA_CORS_ORIGINS=[]
# Required for account endpoints; create the database and run Alembic first.
# NINECGPA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Generate a random secret locally; never commit its value.
# NINECGPA_JWT_SECRET=
NINECGPA_JWT_ISSUER=9cgpa-api
NINECGPA_JWT_AUDIENCE=9cgpa-client
NINECGPA_ACCESS_TOKEN_MINUTES=30

# AI is opt-in. Set provider/model/key locally to enable real provider requests.
NINECGPA_AI_PROVIDER=disabled
# NINECGPA_AI_MODEL=gpt-6-astra
# NINECGPA_AI_API_KEY=
NINECGPA_AI_MAX_TOKENS=2048
NINECGPA_AI_TIMEOUT=30
NINECGPA_AI_PROMPT_VERSION=career-coach-v1
NINECGPA_AI_REQUESTS_PER_MINUTE=5
# Optional for compatible models only. Leave unset for GPT-6 Astra.
# NINECGPA_AI_TEMPERATURE=
